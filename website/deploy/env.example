# Environment for the Indian Gazettes website.
#
# This is the template. The real file holds the secret key, the database
# password and the ingest tokens, and is never committed.
#
# Local development -- settings.py reads website/.env automatically:
#
#     cp deploy/env.example .env
#     chmod 600 .env
#     python -c "import secrets; print(secrets.token_urlsafe(64))"   # secret key
#     $EDITOR .env
#
# Production -- systemd passes it in via EnvironmentFile, so it can live
# outside the checkout:
#
#     sudo install -m 0640 -o root -g www-data env.example /etc/egazette-web.env
#
# Either way, variables already exported in the environment win over the file,
# so a one-off override needs no edit:
#
#     EGAZETTE_DEBUG=true python manage.py runserver
#
# To load a file from somewhere else entirely, set EGAZETTE_ENV_FILE to its
# path; settings.py will fail loudly rather than silently fall back if that
# path does not exist.

# --- required -------------------------------------------------------------

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
EGAZETTE_SECRET_KEY=change-me

EGAZETTE_ALLOWED_HOSTS=gazettes.example.org,www.gazettes.example.org
EGAZETTE_CSRF_TRUSTED_ORIGINS=https://gazettes.example.org

# --- database -------------------------------------------------------------

EGAZETTE_DB_NAME=egazette
EGAZETTE_DB_USER=egazette
EGAZETTE_DB_PASSWORD=change-me
EGAZETTE_DB_HOST=127.0.0.1
EGAZETTE_DB_PORT=5432

# --- gazette data ---------------------------------------------------------

# Directories laid out like the scraper's data dir (raw/, metatags/, html/,
# pymupdf/), searched in this order. Listing the scraper's own directory here
# lets the site serve the PDFs and pymupdf renderings without copying them.
#
#   one host, shared with the scraper:
#     EGAZETTE_DATA_ROOTS=/home/sushant/public/gzdl
#   separate web host, everything arrives by upload:
#     EGAZETTE_DATA_ROOTS=/srv/egazette/data
#   uploads in front of a read-only archive mount:
#     EGAZETTE_DATA_ROOTS=/srv/egazette/data,/mnt/gzdl
EGAZETTE_DATA_ROOTS=/srv/egazette/data

# Where uploads are written. Must be one of the roots above, and writable by
# the site's user. Defaults to the first root.
EGAZETTE_WRITE_ROOT=/srv/egazette/data

# --- ingest API -----------------------------------------------------------

# Shared secrets accepted by /api/ingest/, comma-separated. Leave empty to
# close the endpoint entirely (a site updated only by `manage.py
# ingest_gazettes` needs no token at all). Rotate by listing the new token
# alongside the old one, updating the pushers, then dropping the old one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EGAZETTE_INGEST_TOKENS=

# --- optional -------------------------------------------------------------

# Text search configuration. Changing it needs `manage.py reindex_gazettes
# --all`. 'english' stems English while leaving Indic scripts intact.
# EGAZETTE_TS_CONFIG=english

# Serve PDFs through nginx instead of streaming them from Python. Requires
# the internal location blocks in nginx.conf.
# EGAZETTE_USE_X_ACCEL=true
# EGAZETTE_X_ACCEL_PREFIX=/protected/

# TLS. nginx.conf already redirects to HTTPS and sends HSTS, so these stay off
# by default; turn them on when running behind a different proxy, or none.
# Enable HSTS only once every hostname the site answers on serves HTTPS.
# EGAZETTE_SSL_REDIRECT=true
# EGAZETTE_HSTS_SECONDS=31536000
# EGAZETTE_HSTS_INCLUDE_SUBDOMAINS=true

# How long a reader stays signed in, in seconds. Accounts exist only to hold
# bookmarks, so the session is long by default (30 days) -- a sign-in that
# expired with the browser would make saved gazettes useless.
# EGAZETTE_SESSION_COOKIE_AGE=2592000

# Rendered gazette bodies are cached; the default is per-process memory.
# EGAZETTE_CACHE_BACKEND=django.core.cache.backends.memcached.PyMemcacheCache
# EGAZETTE_CACHE_LOCATION=127.0.0.1:11211

# EGAZETTE_STATIC_ROOT=/srv/egazette/static
# EGAZETTE_SITE_NAME=Indian Gazettes
# EGAZETTE_RESULTS_PER_PAGE=20
# EGAZETTE_LOG_LEVEL=INFO
# EGAZETTE_TIME_ZONE=Asia/Kolkata
